cat > Makefile <<'EOF'
CC = gcc
DEBUG ?= 1
CFLAGS = -Wall -Wextra -O2 -fPIC -Iinclude -DDEBUG_ENABLED=$(DEBUG)
RPATH = -Wl,-rpath,'$$ORIGIN/../lib'

.PHONY: all clean
all: lib/libcommon.so bin/server bin/client

lib/libcommon.so: src/common.c include/common.h
	mkdir -p lib
	$(CC) $(CFLAGS) -shared -o $@ src/common.c

bin/server: src/server.c include/common.h lib/libcommon.so
	mkdir -p bin
	$(CC) $(CFLAGS) -o $@ src/server.c -Llib -lcommon $(RPATH)

bin/client: src/client.c include/common.h lib/libcommon.so
	mkdir -p bin
	$(CC) $(CFLAGS) -o $@ src/client.c -Llib -lcommon $(RPATH)

clean:
	rm -f bin/server bin/client lib/libcommon.so
EOF
